# PostgreSQL connection string (for example from Neon). Tests and the browser test use their own
# schemas ("test" and "e2e") inside this same database, so your real data in "public" is never touched.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Secret used to hash session tokens. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Public base URL, used to build invite links
APP_URL=http://localhost:3000

# Gemini (optional). Without a key every AI feature falls back to templates.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Email (optional). Without SMTP_HOST, emails are printed in the server log instead of being sent,
# and admins still get copyable invite and reset links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true for port 465 (TLS from the start); leave unset for 587/25 (STARTTLS)
SMTP_SECURE=
SMTP_FROM="Threadline <no-reply@yourdomain.com>"

# Shown on the Privacy Policy as the place to send data requests
LEGAL_CONTACT_EMAIL=
